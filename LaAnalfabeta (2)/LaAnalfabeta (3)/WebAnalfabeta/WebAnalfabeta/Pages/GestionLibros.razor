@page "/gestion-libros"
@attribute [Authorize(Roles = "Admin,Administrador")]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav


@if (cargando)
{
    <div class="text-center my-5" style="margin-top: 20vh !important;">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
        <p class="mt-3 text-muted fs-5">Verificando permisos de administrador...</p>
    </div>
}

else if (!esAdmin)
{
    <div class="container mt-5 text-center">
        <div class="alert alert-danger shadow-sm p-5" style="margin-top: 10vh;">
            <i class="bi bi-shield-lock-fill display-1"></i>
            <h2 class="mt-3">Acceso Denegado</h2>
            <p class="fs-5">No tienes permisos de Administrador para estar aquí.</p>
            <button class="btn btn-primary mt-3" @onclick="IrAlCatalogo">Volver al Catálogo</button>
        </div>
    </div>
}
else
{

    <div class="container-fluid mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
            <h2 class="fw-bold mb-0 text-primary">
                <i class="bi bi-gear-fill me-2"></i> Panel de Administración: Libros
            </h2>
            <button class="btn btn-success shadow-sm" @onclick="AbrirModalNuevo">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Libro
            </button>
        </div>

        <div class="row">

            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-dark text-white fw-bold">
                        <i class="bi bi-list-ul me-2"></i> Catálogo
                    </div>
                    <div class="p-2 border-bottom bg-light">
                        <input type="text" class="form-control form-control-sm" placeholder="Buscar libro..." @bind="textoBusqueda" @bind:event="oninput" />
                    </div>
                    <div class="list-group list-group-flush overflow-auto" style="max-height: 70vh;">
                        @if (libros != null && libros.Count > 0)
                        {
                            @foreach (var lib in LibrosFiltrados)
                            {
                                <button class="list-group-item list-group-item-action border-0 py-3 @(libroSeleccionado?.LibroID == lib.LibroID ? "active bg-primary text-white shadow-sm" : "")"
                                        @onclick="() => SeleccionarLibro(lib)">
                                    <div class="d-flex w-100 justify-content-between align-items-center">
                                        <h6 class="mb-1 text-truncate fw-bold" style="max-width: 80%;">@lib.titulo</h6>
                                        <span class="badge @(lib.disponible ? "bg-success" : "bg-danger")">
                                            @(lib.disponible ? "Disp." : "Prest.")
                                        </span>
                                    </div>
                                    <small class="text-truncate d-block @(libroSeleccionado?.LibroID == lib.LibroID ? "text-white-50" : "text-muted")">
                                        <i class="bi bi-person me-1"></i>@lib.autor
                                    </small>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-8 col-lg-9">
                @if (libroSeleccionado == null)
                {
                    <div class="card shadow-sm border-0 h-100 d-flex justify-content-center align-items-center bg-light" style="min-height: 400px;">
                        <div class="text-center text-muted">
                            <i class="bi bi-hand-index-thumb display-1 text-secondary opacity-50"></i>
                            <h4 class="mt-3">Ningún libro seleccionado</h4>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-start">
                            <div>
                                <h3 class="fw-bold text-primary mb-1">@libroSeleccionado.titulo</h3>
                                <h5 class="text-muted"><i class="bi bi-pencil me-1"></i> @libroSeleccionado.autor</h5>
                            </div>
                            <div>
                                <button class="btn btn-outline-primary btn-sm me-2" @onclick="EditarSeleccionado">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="EliminarSeleccionado">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row mt-3">
                                <div class="col-md-4 text-center mb-3">
                                    <div class="p-3 bg-light rounded-3 border" style="min-height: 250px; display: flex; align-items: center; justify-content: center;">
                                        @if (!string.IsNullOrEmpty(libroSeleccionado.imagenRuta))
                                        {
                                            <img src="/imagenes/@libroSeleccionado.imagenRuta" class="img-fluid rounded shadow" style="max-height: 250px; object-fit: contain;" alt="Portada" />
                                        }
                                        else
                                        {
                                            <div class="text-muted">
                                                <i class="bi bi-image display-3"></i>
                                                <p class="mt-2 mb-0">Sin portada</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <table class="table table-bordered table-striped">
                                        <tbody>
                                            <tr>
                                                <th style="width: 30%;">Código</th>
                                                <td>@libroSeleccionado.codigo</td>
                                            </tr>
                                            <tr>
                                                <th>Editorial</th>
                                                <td>@(string.IsNullOrEmpty(libroSeleccionado.editorial) ? "No registrada" : libroSeleccionado.editorial)</td>
                                            </tr>
                                            <tr>
                                                <th>Estado</th>
                                                <td>
                                                    @if (libroSeleccionado.disponible)
                                                    {
                                                        <span class="badge fs-6 bg-success">Disponible</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge fs-6 bg-danger">Prestado</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>ID Base de Datos</th>
                                                <td class="text-muted">@libroSeleccionado.LibroID</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    
    @if (mostrarModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4">
                    <div class="modal-header bg-light border-0 rounded-top-4">
                        <h5 class="modal-title fw-bold">@(libroActual.LibroID == 0 ? "Agregar Nuevo Libro" : "Editar Libro")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Título</label>
                            <input class="form-control" @bind="libroActual.titulo" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Autor</label>
                            <input class="form-control" @bind="libroActual.autor" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Código</label>
                                <input class="form-control" @bind="libroActual.codigo" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Editorial</label>
                                <input class="form-control" @bind="libroActual.editorial" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Imagen</label>
                            <input class="form-control" @bind="libroActual.imagenRuta" />
                        </div>
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" role="switch" id="switchDisponible" @bind="libroActual.disponible">
                            <label class="form-check-label fw-semibold" for="switchDisponible">¿Está disponible?</label>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="GuardarLibro">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<Libro>? libros;
    private Libro? libroSeleccionado;
    private string textoBusqueda = "";
    private bool mostrarModal = false;
    private Libro libroActual = new Libro();

    
    private bool esAdmin = false;
    private bool cargando = true;

    private List<Libro> LibrosFiltrados
    {
        get
        {
            if (libros == null) return new List<Libro>();
            if (string.IsNullOrWhiteSpace(textoBusqueda)) return libros;
            return libros.Where(l => l.titulo.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                                     l.autor.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            var rol = await JS.InvokeAsync<string>("localStorage.getItem", "rol");

            
            if (string.IsNullOrEmpty(token))
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }

            
            if (rol == "Admin" || rol == "Administrador")
            {
                esAdmin = true;

                
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                libros = await Http.GetFromJsonAsync<List<Libro>>("api/Libros");

                if (libros != null && libros.Count > 0)
                {
                    libroSeleccionado = libros.First();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
            
            Nav.NavigateTo("/login", forceLoad: true);
        }
        finally
        {
            cargando = false; 
        }
    }

    

    private void IrAlCatalogo()
    {
        Nav.NavigateTo("/libros");
    }

    private void SeleccionarLibro(Libro libro)
    {
        libroSeleccionado = libro;
    }

    private void EditarSeleccionado()
    {
        if (libroSeleccionado != null)
        {
            AbrirModalEditar(libroSeleccionado);
        }
    }

    private void EliminarSeleccionado()
    {
        if (libroSeleccionado != null)
        {
            EliminarLibro(libroSeleccionado.LibroID);
        }
    }

    private void AbrirModalNuevo()
    {
        libroActual = new Libro { disponible = true };
        mostrarModal = true;
    }

    private void AbrirModalEditar(Libro libro)
    {
        libroActual = new Libro
        {
            LibroID = libro.LibroID,
            titulo = libro.titulo,
            autor = libro.autor,
            codigo = libro.codigo,
            editorial = libro.editorial,
            imagenRuta = libro.imagenRuta,
            disponible = libro.disponible
        };
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        libroActual = new Libro();
    }

    private void GuardarLibro()
    {
        if (libroActual.LibroID == 0)
        {
            libroActual.LibroID = new Random().Next(1000, 9999);
            libros?.Add(libroActual);
        }
        else
        {
            if (libros != null)
            {
                var index = libros.FindIndex(l => l.LibroID == libroActual.LibroID);
                if (index != -1) libros[index] = libroActual;
            }
            libroSeleccionado = libroActual;
        }
        mostrarModal = false;
    }

    private void EliminarLibro(int id)
    {
        var lib = libros?.FirstOrDefault(l => l.LibroID == id);
        if (lib != null && libros != null)
        {
            libros.Remove(lib);
            libroSeleccionado = null;
        }
    }

    public class Libro
    {
        public int LibroID { get; set; }
        public string codigo { get; set; } = string.Empty;
        public string titulo { get; set; } = string.Empty;
        public string autor { get; set; } = string.Empty;
        public string editorial { get; set; } = string.Empty;
        public string imagenRuta { get; set; } = string.Empty;
        public bool disponible { get; set; }
    }
}